---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<html lang="en">
<head>
  <BaseHead title={`${SITE_TITLE} — ${SITE_DESCRIPTION}`} description={SITE_DESCRIPTION} />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    /* Starfield */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.35), transparent),
        radial-gradient(1px 1px at 30% 65%, rgba(255,255,255,0.25), transparent),
        radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.4), transparent),
        radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.2), transparent),
        radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.35), transparent),
        radial-gradient(1px 1px at 15% 85%, rgba(255,255,255,0.25), transparent),
        radial-gradient(1px 1px at 45% 55%, rgba(255,255,255,0.2), transparent),
        radial-gradient(1px 1px at 75% 15%, rgba(255,255,255,0.3), transparent),
        radial-gradient(1px 1px at 25% 45%, rgba(255,255,255,0.2), transparent),
        radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,0.25), transparent),
        radial-gradient(1px 1px at 5% 50%, rgba(255,255,255,0.18), transparent),
        radial-gradient(1px 1px at 60% 90%, rgba(255,255,255,0.3), transparent),
        radial-gradient(1px 1px at 35% 30%, rgba(255,255,255,0.15), transparent),
        radial-gradient(1px 1px at 95% 25%, rgba(255,255,255,0.25), transparent),
        radial-gradient(1px 1px at 55% 75%, rgba(255,255,255,0.18), transparent),
        radial-gradient(1.5px 1.5px at 20% 70%, rgba(255,255,255,0.4), transparent),
        radial-gradient(1.5px 1.5px at 80% 35%, rgba(255,255,255,0.35), transparent),
        radial-gradient(1.5px 1.5px at 40% 5%, rgba(255,255,255,0.38), transparent);
      pointer-events: none;
      z-index: 0;
    }

    /* Nebula glow */
    body::after {
      content: '';
      position: fixed;
      top: -20%;
      left: -10%;
      width: 60%;
      height: 50%;
      background: radial-gradient(ellipse, rgba(58, 75, 180, 0.10), transparent 70%);
      pointer-events: none;
      z-index: 0;
      animation: nebulaDrift 12s ease-in-out infinite alternate;
    }
    @keyframes nebulaDrift {
      from { transform: translate(0, 0); opacity: 0.7; }
      to { transform: translate(30px, 15px); opacity: 1; }
    }

    .container { max-width: 960px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 1; }

    /* Nav */
    nav {
      position: sticky;
      top: 0;
      z-index: 101;
      padding: 16px 0;
      background: rgba(6, 8, 16, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    nav .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo {
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .logo a {
      text-decoration: none;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .nav-links { display: flex; align-items: center; gap: 24px; }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text); }

    /* Fade-in-up for scroll reveals */
    .fade-in {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Hero */
    .hero {
      padding: 100px 0 80px;
      text-align: center;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -40px;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 400px;
      background: radial-gradient(ellipse, var(--glow-1), transparent 60%),
                  radial-gradient(ellipse at 60% 40%, var(--glow-2), transparent 60%);
      pointer-events: none;
      z-index: -1;
      animation: heroGlow 6s ease-in-out infinite alternate;
    }
    @keyframes heroGlow {
      from { opacity: 0.7; transform: translateX(-50%) scale(1); }
      to { opacity: 1; transform: translateX(-50%) scale(1.05); }
    }
    .hero h1 {
      font-size: 3.6rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .hero h1 .gradient-text,
    .features h2 .gradient-text {
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .etymology {
      font-size: 1.3rem;
      margin-bottom: 28px;
      letter-spacing: 0.04em;
      color: var(--muted);
      position: relative;
      display: inline-flex;
      justify-content: center;
      overflow: hidden;
      height: 2em;
      align-items: center;
    }
    .etymology-inner {
      display: inline-flex;
      position: relative;
      white-space: nowrap;
    }
    .etymology .ch {
      display: inline-block;
      transition: all 1.2s cubic-bezier(0.25, 0.1, 0.25, 1);
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    }
    .etymology .ch.lit {
      color: var(--accent-bright);
      font-weight: 700;
    }
    .etymology .ch.dim {
      opacity: 0.5;
    }
    .etymology .ch.space {
      width: 0.4em;
    }
    .etymology.squash .ch.dim {
      opacity: 0;
      width: 0;
      margin: 0;
      padding: 0;
      font-size: 0;
    }
    .etymology.squash .ch.space {
      width: 0;
    }
    .etymology.squash .ch.lit {
      font-size: 2rem;
      letter-spacing: 0.08em;
    }
    .etymology .pronunciation {
      display: inline-block;
      font-style: italic;
      color: var(--muted);
      margin-left: 12px;
      font-size: 0.75em;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.6s ease, transform 0.6s ease;
      font-family: var(--font-body, system-ui, sans-serif);
    }
    .etymology.squash .pronunciation {
      opacity: 1;
      transform: translateY(0);
    }

    .hero p {
      font-size: 1.15rem;
      color: var(--text-secondary);
      max-width: 520px;
      margin: 0 auto 40px;
      line-height: 1.7;
    }

    /* Terminal code block */
    .terminal {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      margin: 0 auto 48px; text-align: left;
      max-width: 580px;
      overflow: hidden;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .terminal:hover {
      border-color: var(--border-hover);
      box-shadow: 0 0 40px rgba(58, 75, 180, 0.08);
    }
    .terminal-header {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 13px 18px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
    }
    .terminal-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
    }
    .terminal-dot:nth-child(1) { background: #f0544c; }
    .terminal-dot:nth-child(2) { background: #f0c74c; }
    .terminal-dot:nth-child(3) { background: #4cf07a; }
    .terminal-title {
      font-size: 0.75rem;
      color: var(--muted);
      margin-left: 8px;
      font-weight: 500;
    }
    .terminal-body {
      padding: 22px 24px;
      overflow-x: auto;
    }
    .terminal-body pre {
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
      font-size: 0.78rem;
      line-height: 1.75;
      color: var(--text-secondary);
    }
    .terminal-body .kw { color: #c084fc; }
    .terminal-body .str { color: var(--teal-bright); }
    .terminal-body .fn { color: var(--accent-bright); }
    .terminal-body .cm { color: var(--muted); }

    /* CTAs */
    .cta-row {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 28px;
      border-radius: 10px;
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.25s;
    }
    .btn-primary {
      background: linear-gradient(135deg, #c0302a, #d4443e);
      color: #fff;
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, #d4443e, #e05a54);
      box-shadow: 0 0 24px rgba(192, 48, 42, 0.20);
      transform: translateY(-1px);
    }
    .btn-secondary {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      border-color: var(--border-hover);
      transform: translateY(-1px);
    }

    /* Stats row */
    .stats {
      padding: 48px 0;
      border-top: 1px solid var(--border);
    }
    .stats-grid {
      display: flex;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
    }
    .stat {
      text-align: center;
    }
    .stat-number {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      background: var(--gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-label {
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 4px;
      font-weight: 500;
    }

    /* Features - Bento Grid */
    .features {
      padding: 60px 0;
      border-top: 1px solid var(--border);
    }
    .features h2 {
      text-align: center;
      font-size: 1.8rem;
      margin-bottom: 40px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .bento {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 16px;
    }
    .bento-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 28px;
      transition: border-color 0.3s, transform 0.3s;
    }
    .bento-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }
    .bento-card.wide {
      grid-column: 1 / -1;
    }
    .bento-card h3 {
      font-size: 1.05rem;
      margin-bottom: 10px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .bento-card .card-accent {
      display: inline-block;
      width: 32px;
      height: 3px;
      border-radius: 2px;
      margin-bottom: 16px;
    }
    .bento-card:nth-child(1) .card-accent { background: var(--accent-2); }
    .bento-card:nth-child(2) .card-accent { background: var(--teal); }
    .bento-card:nth-child(3) .card-accent { background: var(--warm); }
    .bento-card:nth-child(4) .card-accent { background: var(--warm); }
    .bento-card:nth-child(5) .card-accent { background: linear-gradient(90deg, var(--accent-2), var(--teal)); }
    .bento-card:nth-child(6) .card-accent { background: var(--accent-2); }
    .bento-card p {
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Get Started */
    .get-started {
      padding: 70px 0;
      border-top: 1px solid var(--border);
      text-align: center;
    }
    .get-started h2 {
      font-size: 1.8rem;
      margin-bottom: 12px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .get-started p {
      color: var(--text-secondary);
      margin-bottom: 28px;
      font-size: 0.95rem;
    }
    .steps {
      display: flex;
      gap: 24px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }
    .step {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 24px;
      text-align: left;
      flex: 1;
      min-width: 210px;
      max-width: 280px;
      transition: border-color 0.3s, transform 0.3s;
    }
    .step:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }
    .step-num {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--warm);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }
    .step-text {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.78rem;
      color: var(--text-secondary);
    }

    /* Works with */
    .works-with {
      margin-top: 40px;
      color: var(--muted);
      font-size: 0.85rem;
    }
    .works-with span {
      display: inline-flex;
      gap: 20px;
      margin-top: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .works-with .agent-name {
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.9rem;
    }

    /* Open source CTA */
    .open-source {
      padding: 70px 0;
      border-top: 1px solid var(--border);
    }
    .open-source-inner {
      background: var(--gradient-subtle);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px 36px;
      position: relative;
      overflow: hidden;
      text-align: center;
    }
    .open-source-inner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient);
    }
    .open-source-inner h2 {
      font-size: 1.5rem;
      font-weight: 800;
      margin-bottom: 12px;
      letter-spacing: -0.02em;
    }
    .open-source-inner p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 480px;
      margin: 0 auto 24px;
    }

    /* Footer */
    footer {
      padding: 40px 0;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 0.78rem;
    }
    footer a { color: var(--muted); text-decoration: none; }
    footer a:hover { color: var(--text); }
    footer .footer-links {
      display: flex;
      gap: 20px;
      justify-content: center;
      margin-bottom: 12px;
    }

    @media (max-width: 600px) {
      .hero h1 { font-size: 2.4rem; }
      .hero { padding: 60px 0 50px; }
      .bento { grid-template-columns: 1fr; }
      .bento-card.wide { grid-column: 1; }
      .stats-grid { gap: 32px; }
      .steps { flex-direction: column; align-items: center; }
      .step { max-width: 100%; }
      .nav-links { gap: 14px; }
      .nav-links a { font-size: 0.78rem; }
    }
    @media (max-width: 420px) {
      nav .container { flex-direction: column; gap: 10px; }
      .nav-links { gap: 12px; flex-wrap: wrap; justify-content: center; }
      .nav-links a { font-size: 0.76rem; }
      .hero h1 { font-size: 2rem; }
      .etymology.squash .ch.lit { font-size: 1.5rem; }
      .terminal-body pre { font-size: 0.7rem; }
      .cta-row { flex-direction: column; align-items: center; }
    }
  </style>
</head>
<body>
  <nav>
    <div class="container">
      <div class="logo"><a href="/">AGENR</a></div>
      <div class="nav-links">
        <a href="https://github.com/agenr-ai/agenr">GitHub</a>
        <a href="https://github.com/agenr-ai/agenr#readme">Docs</a>
        <a href="/blog">Blog</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <h1><span class="gradient-text">Agent &middot; Memory</span></h1>
      <div class="etymology" id="etymology">
        <span class="etymology-inner">
          <span class="ch lit">A</span><span class="ch lit">G</span><span class="ch lit">E</span><span class="ch lit">N</span><span class="ch dim">t</span><span class="ch space"> </span><span class="ch dim">m</span><span class="ch dim">e</span><span class="ch dim">m</span><span class="ch dim">o</span><span class="ch lit">R</span><span class="ch dim">y</span>
          <span class="pronunciation">AY-GEN-ER</span>
        </span>
      </div>
      <script>
        (function() {
          var el = document.getElementById('etymology');
          if (!el) return;
          setTimeout(function() { el.classList.add('squash'); }, 1800);
        })();
      </script>
      <p>Local-first memory for AI agents. Extract structured knowledge, recall it across tools, consolidate it over time.</p>

      <div class="terminal">
        <div class="terminal-header">
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <span class="terminal-title">memory.ts</span>
        </div>
        <div class="terminal-body">
          <pre><span class="kw">import</span> &#123; <span class="fn">recall</span> &#125; <span class="kw">from</span> <span class="str">"agenr"</span>;

<span class="cm">// Extract knowledge from a conversation</span>
agenr extract session.jsonl --json | agenr store

<span class="cm">// Later — in any tool, any session</span>
<span class="kw">const</span> memories = <span class="kw">await</span> <span class="fn">recall</span>(<span class="str">"what did we decide about auth?"</span>);
<span class="cm">// → fact (0.94): We switched to OAuth2 with PKCE flow</span>
<span class="cm">// → decision (0.88): API keys for server-to-server only</span></pre>
        </div>
      </div>

      <div class="cta-row">
        <a href="https://github.com/agenr-ai/agenr" class="btn btn-primary">View on GitHub</a>
        <a href="https://github.com/agenr-ai/agenr#readme" class="btn btn-secondary">Read the Docs</a>
      </div>
    </div>
  </section>

  <section class="features fade-in">
    <div class="container">
      <h2><span class="gradient-text">How It Works</span></h2>
      <div class="bento">
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Structured Extraction</h3>
          <p>LLM extracts typed entries — facts, decisions, preferences, todos, events, lessons — from any conversation. Not just summaries. Real knowledge.</p>
        </div>
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Memory That Learns</h3>
          <p>Entries strengthen when recalled, decay when stale, and get penalized when contradicted. FSRS-style forgetting curve keeps your knowledge fresh.</p>
        </div>
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Cross-Tool Memory</h3>
          <p>One local DB shared via MCP. Claude Code, Codex, Cursor — same brain. Your knowledge follows you across every tool.</p>
        </div>
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Consolidation</h3>
          <p>Near-duplicates merge. Stale entries expire. The DB gets healthier over time, not just bigger.</p>
        </div>
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Local-First</h3>
          <p>Your memory stays on your machine. SQLite database. No cloud dependency for storage. Your data, your control.</p>
        </div>
        <div class="bento-card">
          <div class="card-accent"></div>
          <h3>Open Protocol</h3>
          <p>Works with any tool that speaks MCP. Three tools: recall, store, extract. That's the entire API surface.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="get-started fade-in">
    <div class="container">
      <h2>Get Started</h2>
      <p>Three steps to give your AI agents memory.</p>
      <div class="steps">
        <div class="step">
          <div class="step-num">Install</div>
          <div class="step-text">npm install -g agenr</div>
        </div>
        <div class="step">
          <div class="step-num">Setup</div>
          <div class="step-text">agenr setup</div>
        </div>
        <div class="step">
          <div class="step-num">Remember</div>
          <div class="step-text">agenr extract transcript.jsonl --json | agenr store</div>
        </div>
      </div>
      <div class="works-with">
        Works with any MCP client
        <br>
        <span>
          <span class="agent-name">Claude Code</span>
          <span class="agent-name">Codex</span>
          <span class="agent-name">Cursor</span>
          <span class="agent-name">OpenClaw</span>
          <span class="agent-name">Any MCP Client</span>
        </span>
      </div>
    </div>
  </section>

  <section class="open-source fade-in">
    <div class="container">
      <div class="open-source-inner">
        <h2>Open Source. Local First.</h2>
        <p>AGENR is AGPL-3.0 licensed and built in the open. Your AI's memory should belong to you, not a cloud provider. Contribute, fork, or just <strong style="color: var(--text)">remember everything.</strong></p>
        <div class="cta-row">
          <a href="https://github.com/agenr-ai/agenr" class="btn btn-primary">Star on GitHub</a>
          <a href="https://x.com/agenr_ai" class="btn btn-secondary">Follow @agenr_ai</a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-links">
        <a href="https://github.com/agenr-ai/agenr">GitHub</a>
        <a href="https://github.com/agenr-ai/agenr#readme">Docs</a>
        <a href="/blog">Blog</a>
        <a href="https://x.com/agenr_ai">X</a>
      </div>
      <p>AGPL-3.0 License &middot; <a href="https://x.com/agenr_ai">@agenr_ai</a></p>
    </div>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>
</body>
</html>
